# --- Storage provider selection ---
# auto = first configured in [cloudinary, googledrive, imagekit, imgbb, catbox]
# Or force order, e.g. STORAGE_PROVIDER=cloudinary,imgbb
STORAGE_PROVIDER=auto
MAX_UPLOAD_MB=15
ALLOWED_ORIGINS=https://pixelwalls.vercel.app,http://localhost:5173
# ALLOW_ALL_ORIGINS=true  # dev only

# --- Cloudinary (RECOMMENDED free tier: 25GB storage + transforms) ---
# Dashboard: https://cloudinary.com/console  → Programmable Media → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pixelwalls

# --- Google Drive (legacy, kept working) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_JSON={"web":{}}
GOOGLE_TOKEN_JSON={}

# --- ImageKit.io (free 20GB bandwidth) ---
# https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_FOLDER=/pixelwalls

# --- ImgBB (free, 32MB/file, key at https://api.imgbb.com/) ---
IMGBB_API_KEY=

# --- Catbox.moe (free, no key needed; permanent) ---
# Set CATBOX_ENABLED=false to disable the keyless fallback
CATBOX_ENABLED=true

# --- Local JSON metadata store (for imgbb/catbox/imagekit listings) ---
# Defaults to ./data/wallpapers.json
# WALLPAPERS_DATA_DIR=./data
# WALLPAPERS_JSON_PATH=./data/wallpapers.json

# --- Auth (Neon Postgres + JWT) ---
# Get a free Neon DB at https://neon.tech → New Project → copy pooled connection string
# e.g. postgresql://user:pass@ep-xxx-xxx.neon.tech/pixelwalls?sslmode=require
DATABASE_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Admin secret for registering app clients (offrecord + future apps):
#   POST /api/admin/apps with header x-admin-secret — returns a clientId + secret (shown once)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
# Set to true to reject anonymous uploads (frontend will send Bearer token automatically)
# REQUIRE_AUTH_UPLOAD=false
# Set to true so only premium identities (manual is_premium or app token premium:true) may upload
# REQUIRE_PREMIUM_UPLOAD=false
# NOTE: upload quotas are NOT configured here. Free-upload daily limits live on the
# offrecord side, per app (PATCH /api/admin/apps/:id { freeUploadsPerDay }).
# Manual accounts and guests are governed by the flags above, not by quota.

PORT=4000
